{
	"name": "@x-captcha/server",
	"version": "1.0.0",
	"description": "Server implementation for X-Captcha service",
	"keywords": [
		"captcha",
		"security",
		"server"
	],
	"license": "MIT",
	"author": "ElsiKora",
	"type": "commonjs",
	"main": "dist/main.js",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "npm run prebuild && nest build && npm run start:generate-swagger",
		"commit": "cz",
		"deploy": "npm ci && npm run build && npm run start:prod",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint ./src && prettier --check .",
		"lint:all": "npm run lint && npm run lint:types",
		"lint:fix": "eslint ./src --fix && prettier --write .",
		"lint:test": "eslint \"{src,apps,libs,test}/**/*.spec.ts\"",
		"lint:types": "tsc --noEmit",
		"lint:watch": "npx eslint-watch ./src/**/*.ts",
		"release": "semantic-release",
		"start": "NODE_ENV=production nest start",
		"start:debug": "nest start --debug --watch",
		"start:dev": "NODE_ENV=development nest start --watch",
		"start:generate-swagger": "NODE_ENV=generate-swagger node dist/main.js",
		"start:prod": "NODE_ENV=production node dist/main.js"
	},
	"config": {
		"commitizen": {
			"path": "@elsikora/commitizen-plugin-commitlint-ai"
		}
	},
	"dependencies": {
		"@aws-sdk/client-cloudwatch-logs": "^3.859.0",
		"@elsikora/nestjs-aws-parameter-store-config": "^1.2.14",
		"@elsikora/nestjs-crud-automator": "^1.10.4",
		"@elsikora/nestjs-crud-config": "^1.1.4",
		"@elsikora/nestjs-typeorm-aws-connector": "^1.3.1",
		"@fastify/static": "^8.2.0",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.1.5",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.5",
		"@nestjs/event-emitter": "^3.0.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-fastify": "^11.1.5",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/typeorm": "^11.0.0",
		"@sentry/node": "^10.1.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cors": "^2.8.5",
		"fastify": "^5.4.0",
		"passport-custom": "^1.1.1",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"request-ip": "^3.3.0",
		"rxjs": "^7.8.2",
		"typeorm": "^0.3.25",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@elsikora/commitizen-plugin-commitlint-ai": "^2.0.1",
		"@elsikora/eslint-config": "^3.10.0",
		"@elsikora/eslint-plugin-nestjs-typed": "^3.0.1",
		"@nestjs/cli": "^11.0.10",
		"@saithodev/semantic-release-backmerge": "^4.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.3",
		"@semantic-release/npm": "^12.0.2",
		"@semantic-release/release-notes-generator": "^14.0.3",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jest": "^30.0.0",
		"@types/request-ip": "^0.0.41",
		"@types/uuid": "^10.0.0",
		"commitizen": "^4.3.1",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"eslint": "^9.32.0",
		"eslint-plugin-n": "^17.21.3",
		"eslint-plugin-ng-module-sort": "^1.3.2",
		"eslint-plugin-no-secrets": "^2.2.1",
		"eslint-plugin-typeorm-typescript": "^0.5.1",
		"husky": "^9.1.7",
		"jest": "^30.0.5",
		"lint-staged": "^16.1.4",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"semantic-release": "^24.2.7",
		"typescript": "^5.9.2"
	}
}
